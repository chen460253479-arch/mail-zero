# Zero 最小运行配置
VITE_PUBLIC_APP_URL=http://localhost:3000
VITE_PUBLIC_BACKEND_URL=http://localhost:8787

# Server 使用部署者提供的私有 S3 兼容对象存储保存完整 MIME 与附件。
MAIL_BLOB_STORE=s3
MAIL_BLOB_S3_ENDPOINT=https://objects.example.com
MAIL_BLOB_S3_REGION=your-s3-region
MAIL_BLOB_S3_BUCKET=your-private-mail-bucket
MAIL_BLOB_S3_PREFIX=mail
MAIL_BLOB_S3_ACCESS_KEY_ID=your-s3-access-key
MAIL_BLOB_S3_SECRET_ACCESS_KEY=your-s3-secret-key

# 宿主机开发与迁移命令使用；Docker PostgreSQL 使用 Compose 默认配置。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zerodotemail"

# 使用 `openssl rand -base64 32` 生成，所有 Server 实例必须保持一致。
CREDENTIAL_ENCRYPTION_KEY=

# 使用 `openssl rand -hex 32` 生成 32 字节（64 个十六进制字符）的随机密钥。
BETTER_AUTH_SECRET=
COOKIE_DOMAIN=localhost

# 宿主机开发使用；Docker Server 会连接 Compose 内部的 upstash-proxy。
REDIS_URL=http://localhost:8079
REDIS_TOKEN=upstash-local-token

# 可选：Docker 对外端口与 Server 进程参数。未配置时使用下列默认值。
# ZERO_MAIL_PORT=3000
# ZERO_SERVER_PORT=8787
# ZERO_SERVER_HOST=0.0.0.0
# ZERO_SHUTDOWN_GRACE_MS=30000
# POSTGRES_PORT=5432
# VALKEY_PORT=6379
# REDIS_HTTP_PORT=8079
# NODE_ENV=development

# 可选：部分 S3 兼容服务需要路径风格访问。
# MAIL_BLOB_S3_FORCE_PATH_STYLE=false

# 可选：前端图片代理与头像服务；修改后需要重新构建 Mail 镜像。
# VITE_PUBLIC_IMAGE_PROXY=
# VITE_PUBLIC_IMAGE_API_URL=

# 可选：多个可信前端来源使用英文逗号分隔；默认仅信任 VITE_PUBLIC_APP_URL。
# BETTER_AUTH_TRUSTED_ORIGINS=

# 可选：Nango 邮件连接。BASE_URL 与 SECRET_KEY 必须同时配置。
# NANGO_BASE_URL=
# NANGO_SECRET_KEY=
# NANGO_GMAIL_INTEGRATION_KEY=google-mail
# NANGO_OUTLOOK_INTEGRATION_KEY=outlook
# NANGO_ZOHO_MAIL_INTEGRATION_KEY=zoho-mail
# NANGO_IMAP_SMTP_INTEGRATION_KEY=generic-email

# 可选：仅在确需连接内网邮件服务器时填写精确主机名，多个主机使用英文逗号分隔。
# MAIL_PROTOCOL_ALLOWED_HOSTS=

# 可选：外部系统集成。
# INTEGRATION_API_TOKEN 是外部服务调用 Zero API 使用的固定 Bearer Token。
# 建议使用 `openssl rand -hex 32` 生成 32 字节（64 个十六进制字符）的随机 Token。
# INTEGRATION_API_TOKEN=
# MAIL_WEBHOOK_ENABLED=false
# MAIL_WEBHOOK_URL=https://external.example.com/webhooks/zero-mail

# 可选：私有实例管理员自动创建。启用时名称、邮箱和至少 12 位密码均为必填。
# ZERO_ADMIN_AUTO_PROVISION=false
# ZERO_ADMIN_NAME=Zero Admin
# ZERO_ADMIN_EMAIL=admin@example.com
# ZERO_ADMIN_PASSWORD=
# ZERO_ADMIN_BOOTSTRAP_SECRET 用于 `pnpm nizzy create-admin`，应使用独立的长随机值。
# ZERO_ADMIN_BOOTSTRAP_SECRET=

# 可选：发送账户删除等系统通知邮件。
# RESEND_API_KEY=
