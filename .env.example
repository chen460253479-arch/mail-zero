VITE_PUBLIC_APP_URL=http://localhost:3000
VITE_PUBLIC_BACKEND_URL=http://localhost:8787

# Docker development runtime
ZERO_WRANGLER_ENV=local
ZERO_MAIL_PORT=3000
ZERO_SERVER_PORT=8787
POSTGRES_PORT=5432
VALKEY_PORT=6379
REDIS_HTTP_PORT=8079

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zerodotemail

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zerodotemail"

# Base64-encoded 32-byte key used to encrypt mailbox credentials (`openssl rand -base64 32`).
CREDENTIAL_ENCRYPTION_KEY=

# Nango 仅由 Server 读取；暂不启用时请将下面两项同时留空。
NANGO_BASE_URL=https://api.nango.dev
NANGO_SECRET_KEY=
NANGO_GMAIL_INTEGRATION_KEY=google-mail
NANGO_OUTLOOK_INTEGRATION_KEY=outlook
NANGO_ZOHO_MAIL_INTEGRATION_KEY=zoho-mail
NANGO_IMAP_SMTP_INTEGRATION_KEY=generic-email

# IMAP/SMTP 协议 Worker 只在 Docker 内网监听，不映射宿主机端口。
# 生产环境必须替换为至少 32 个字符的随机值，例如：openssl rand -hex 32
MAIL_PROTOCOL_WORKER_URL=http://protocol-worker:8790
MAIL_PROTOCOL_WORKER_SECRET=zero-local-mail-protocol-worker-secret-change-me
# 默认阻止私网、回环、链路本地和元数据地址。仅在确需连接内网邮件服务器时填写精确主机名。
MAIL_PROTOCOL_ALLOWED_HOSTS=

# Change this to a random string, use `openssl rand -hex 32` to generate a 32 character string
BETTER_AUTH_SECRET=my-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# Local private-instance administrator. Public registration remains disabled.
# Set ZERO_ADMIN_AUTO_PROVISION=true to create this account on the server's first request.
ZERO_ADMIN_AUTO_PROVISION=false
ZERO_ADMIN_NAME="Zero Admin"
ZERO_ADMIN_EMAIL="admin@example.com"
ZERO_ADMIN_PASSWORD=""
# Required by `pnpm nizzy create-admin`; use a long random value.
ZERO_ADMIN_BOOTSTRAP_SECRET=""

COOKIE_DOMAIN="localhost"

# Upstash/Local Redis Instance
REDIS_URL="http://localhost:8079"
REDIS_TOKEN="upstash-local-token"

# Resend API Key
RESEND_API_KEY=

NODE_ENV="development"

# FOR PLAYWRIGHT E2E TESTING
PLAYWRIGHT_SESSION_TOKEN = 
PLAYWRIGHT_SESSION_DATA =
EMAIL =
