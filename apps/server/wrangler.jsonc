{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-server",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/main.ts",
  "env": {
    "local": {
      "rules": [
        {
          "type": "Text",
          "globs": ["**/*.sql"],
          "fallthrough": true,
        },
      ],
      "r2_buckets": [
        {
          "binding": "THREADS_BUCKET",
          "bucket_name": "threads-staging",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ZERO_DB",
            "class_name": "ZeroDB",
          },
        ],
      },
      "queues": {
        "producers": [
          {
            "queue": "mail-ingress-queue",
            "binding": "MAIL_INGRESS_QUEUE",
          },
          {
            "queue": "mail-outbound-queue",
            "binding": "MAIL_OUTBOUND_QUEUE",
          },
        ],
        "consumers": [
          {
            "queue": "mail-ingress-queue",
            "max_batch_size": 10,
            "max_retries": 5,
          },
          {
            "queue": "mail-outbound-queue",
            "max_batch_size": 10,
            "max_retries": 5,
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ZeroDB"],
        },
      ],

      "observability": {
        "enabled": true,
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "57834ddb6716440496c8836f6d99bc9a",
          "localConnectionString": "postgresql://postgres:postgres@localhost:5432/zerodotemail",
        },
      ],
      "vars": {
        "NODE_ENV": "local",
        "COOKIE_DOMAIN": "localhost",
        "VITE_PUBLIC_BACKEND_URL": "http://localhost:8787",
        "VITE_PUBLIC_APP_URL": "http://localhost:3000",
        "JWT_SECRET": "secret",
        "MEET_AUTH_HEADER": "",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "https://api.axiom.co/v1/traces",
        "OTEL_SERVICE_NAME": "zero-email-server-local",
      },
    },
    "staging": {
      "rules": [
        {
          "type": "Text",
          "globs": ["**/*.sql"],
          "fallthrough": true,
        },
      ],
      "triggers": {
        "crons": ["0 0 * * *", "0 * * * *"],
      },
      "limits": {
        "cpu_ms": 300000,
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ZERO_DB",
            "class_name": "ZeroDB",
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "THREADS_BUCKET",
          "bucket_name": "threads-staging",
        },
      ],
      "queues": {
        "producers": [
          {
            "queue": "mail-ingress-queue-staging",
            "binding": "MAIL_INGRESS_QUEUE",
          },
          {
            "queue": "mail-outbound-queue-staging",
            "binding": "MAIL_OUTBOUND_QUEUE",
          },
        ],
        "consumers": [
          {
            "queue": "mail-ingress-queue-staging",
            "max_batch_size": 10,
            "max_retries": 5,
          },
          {
            "queue": "mail-outbound-queue-staging",
            "max_batch_size": 10,
            "max_retries": 5,
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ZeroDB"],
        },
      ],
      "observability": {
        "enabled": true,
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "57834ddb6716440496c8836f6d99bc9a",
          "localConnectionString": "postgresql://postgres:postgres@localhost:5432/zerodotemail",
        },
      ],
      "vars": {
        "NODE_ENV": "development",
        "COOKIE_DOMAIN": "0.email",
        "VITE_PUBLIC_BACKEND_URL": "https://sapi.0.email",
        "VITE_PUBLIC_APP_URL": "https://staging.0.email",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "https://api.axiom.co/v1/traces",
        "OTEL_SERVICE_NAME": "zero-email-server-staging",
      },
    },
    "production": {
      "rules": [
        {
          "type": "Text",
          "globs": ["**/*.sql"],
          "fallthrough": true,
        },
      ],
      "triggers": {
        "crons": ["0 0 * * *", "0 * * * *"],
      },
      "r2_buckets": [
        {
          "binding": "THREADS_BUCKET",
          "bucket_name": "threads",
        },
      ],
      "observability": {
        "enabled": true,
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "b1be316b45fb439a9e54b74ecc20aa21",
          "localConnectionString": "postgresql://postgres:postgres@localhost:5432/zerodotemail",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ZERO_DB",
            "class_name": "ZeroDB",
          },
        ],
      },
      "queues": {
        "producers": [
          {
            "queue": "mail-ingress-queue-prod",
            "binding": "MAIL_INGRESS_QUEUE",
          },
          {
            "queue": "mail-outbound-queue-prod",
            "binding": "MAIL_OUTBOUND_QUEUE",
          },
        ],
        "consumers": [
          {
            "queue": "mail-ingress-queue-prod",
            "max_batch_size": 10,
            "max_retries": 5,
          },
          {
            "queue": "mail-outbound-queue-prod",
            "max_batch_size": 10,
            "max_retries": 5,
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ZeroDB"],
        },
      ],
      "vars": {
        "NODE_ENV": "production",
        "COOKIE_DOMAIN": "0.email",
        "VITE_PUBLIC_BACKEND_URL": "https://api.0.email",
        "VITE_PUBLIC_APP_URL": "https://0.email",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "https://api.axiom.co/v1/traces",
        "OTEL_SERVICE_NAME": "zero-email-server-production",
      },
    },
  },
}
