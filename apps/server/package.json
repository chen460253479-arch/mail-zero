{
  "name": "@zero/server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --show-interactive-dev-session=false --experimental-vectorize-bind-to-prod --env local",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env local",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "tsx src/db/push-development-database.ts",
    "db:push:drizzle": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "protocol-worker": "tsx src/protocol-worker/server.ts",
    "test:mail-core": "vitest run tests/unit/mail-core tests/integration/mail-core",
    "test:cron": "curl 'http://localhost:8787/cdn-cgi/handler/scheduled'"
  },
  "exports": {
    "./trpc": "./src/trpc/index.ts",
    "./mail-api": "./src/modules/mail-api/index.ts",
    "./mail-api-contracts": "./src/modules/mail-api/public-contracts.ts",
    "./auth": "./src/lib/auth.ts",
    "./schemas": "./src/lib/schemas.ts"
  },
  "dependencies": {
    "@barkleapp/css-sanitizer": "1.0.0",
    "@googleapis/gmail": "12.0.0",
    "@googleapis/people": "3.0.9",
    "@hono/trpc-server": "^0.3.4",
    "@react-email/components": "^0.0.41",
    "@react-email/render": "1.1.0",
    "@trpc/server": "catalog:",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.9",
    "@zero/mail-core": "workspace:*",
    "base64-js": "1.5.1",
    "better-auth": "catalog:",
    "cheerio": "1.1.0",
    "drizzle-orm": "catalog:",
    "effect": "3.16.12",
    "email-addresses": "^5.0.0",
    "google-auth-library": "9.15.1",
    "he": "^1.2.0",
    "hono": "^4.7.8",
    "jose": "6.0.11",
    "imapflow": "1.5.0",
    "nodemailer": "9.0.3",
    "postgres": "3.4.5",
    "react": "catalog:",
    "resend": "^4.5.1",
    "sanitize-html": "^2.16.0",
    "superjson": "catalog:",
    "ulid": "3.0.1",
    "uuid": "11.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "0.31.1",
    "@types/he": "1.2.3",
    "@types/node": "^22.9.0",
    "@types/react": "19.1.6",
    "@types/sanitize-html": "2.13.0",
    "@zero/eslint-config": "workspace:*",
    "@zero/tsconfig": "workspace:*",
    "drizzle-kit": "catalog:",
    "eslint": "^9.27.0",
    "jiti": "2.4.2",
    "typescript": "catalog:",
    "vite": "^6.3.5",
    "vitest": "3.2.4",
    "wrangler": "catalog:"
  }
